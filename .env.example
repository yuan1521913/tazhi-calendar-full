# Netlify 环境变量
# 在 Netlify Site configuration > Environment variables 中添加。

# 必填：管理后台与订单管理接口的鉴权令牌
ADMIN_TOKEN=请替换成至少32位随机字符串

# 支付模式：manual 为微信/支付宝收款码 + 人工确认；stripe 为在线支付自动发码
PAYMENT_PROVIDER=manual

# 网站完整地址，Stripe 模式必填，例如 https://tazhi.netlify.app
SITE_URL=https://你的网站.netlify.app

# 以下仅在 PAYMENT_PROVIDER=stripe 时填写
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TRIAL=
STRIPE_PRICE_FULL=
# STRIPE_PRICE_GIFT=
# STRIPE_PRICE_CUSTOM=
